<Window x:Class="FluitendeFietser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="De Fluitende Fietser - Facturering"
        Height="720"
        Width="1150"
        MinHeight="480"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#F2F2F2"
        SizeChanged="Window_SizeChanged">


    <Window.Resources>

        <!-- Normale knop -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
        </Style>

        <!-- Zwarte hoofdknop -->
        <Style x:Key="BlackButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">

            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>

        </Style>

        <!-- Donkergrijze knop -->
        <Style x:Key="DarkButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">

            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#333333"/>

        </Style>

        <!-- Verwijder knop -->
        <Style x:Key="DeleteButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">

            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>

        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">

            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#999999"/>

        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">

            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#999999"/>

        </Style>

    </Window.Resources>

    <!-- HOOFDSCHERM -->

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->


        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="8"
                Padding="18"
                Margin="0,0,0,12">

            <StackPanel>
                <TextBlock Text="DE FLUITENDE FIETSER"
                           FontSize="24" FontWeight="Bold"
                           Foreground="Black" TextWrapping="Wrap"/>
                <TextBlock Text="Fietsverhuur - Facturering"
                           FontSize="14" Foreground="#666666"
                           Margin="0,3,0,10"/>

                <!-- WrapPanel zet de knoppen op een volgende regel als het venster smaller wordt. -->
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="btnVolgendeKlant"
                            Content="Volgende klant →"
                            Style="{StaticResource BlackButton}"
                            Width="170"/>
                    <Button x:Name="btnRekenmachine"
                            Content="Rekenmachine"
                            Style="{StaticResource DarkButton}"
                            Width="170"
                            Click="btnRekenmachine_Click"/>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="txtKlok" Text="00:00:00"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="Black" VerticalAlignment="Center"/>
                        <Button x:Name="btnSetTime" Content="Set time"
                                Width="100" Height="30" FontSize="12"
                                Padding="5" Margin="10,5,0,5"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>

        </Border>


        <!-- MIDDEN VAN HET SCHERM -->


        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="grdResponsive" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>


                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>

                </Grid.ColumnDefinitions>


                <!-- LINKERKANT - ARTIKEL BESTELLEN -->

                <Border x:Name="pnlArtikel" Grid.Column="0" Grid.Row="0" MinHeight="510"
                    Background="White"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,6,0">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!-- TITEL -->

                        <TextBlock Grid.Row="0"
                               Text="Artikel bestellen"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="Black"
                               Margin="0,0,0,15"/>


                        <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">

                            <StackPanel>


                                <!-- FIETSEN -->

                                <TextBlock Text="Fietsen"
                                       FontWeight="SemiBold"
                                       Foreground="Black"/>

                                <ComboBox x:Name="cmbFietsen"/>


                                <!-- VERZEKERINGEN -->

                                <TextBlock Text="Verzekeringen"
                                       FontWeight="SemiBold"
                                       Foreground="Black"/>

                                <ComboBox x:Name="cmbVerzekeringen"/>


                                <!-- SERVICES -->

                                <TextBlock Text="Services"
                                       FontWeight="SemiBold"
                                       Foreground="Black"/>

                                <ComboBox x:Name="cmbServices"/>


                                <!-- AANTAL DAGEN -->


                                <TextBlock Text="Aantal dagen"
                                       FontWeight="SemiBold"
                                       Foreground="Black"/>

                                <TextBox x:Name="txtAantalDagen"
                                     Text="1"
                                     Margin="0,5,0,15"/>



                                <!-- PRIJS -->


                                <Border Background="#EEEEEE"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,5,0,10">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Prijs geselecteerd:"
                                               Foreground="Black"
                                               VerticalAlignment="Center"/>

                                        <TextBlock x:Name="txtGeselecteerdePrijs"
                                               Grid.Column="1"
                                               Text="€ 0,00"
                                               Foreground="Black"
                                               FontSize="18"
                                               FontWeight="Bold"/>

                                    </Grid>

                                </Border>


                                <!-- CSV INFO -->

                                <TextBlock Text="Artikelen worden ingelezen uit het CSV-bestand."
                                       Foreground="#666666"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                            </StackPanel>

                        </ScrollViewer>

                        <!-- BESTEL ARTIKEL KNOP -->


                        <Button x:Name="btnBestelArtikel"
                            Grid.Row="2"
                            Content="Bestel artikel"
                            Style="{StaticResource BlackButton}"
                            Height="50"
                            Margin="0,10,0,0"/>

                    </Grid>

                </Border>


                <!-- RECHTERKANT -->


                <Grid x:Name="pnlBestelling" Grid.Column="1"
                  Margin="6,0,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- HUIDIGE BESTELLING -->

                    <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15"
                        Margin="0,0,0,6">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>


                            <!-- TITEL -->

                            <TextBlock Grid.Row="0"
                                   Text="Huidige bestelling"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="Black"
                                   Margin="0,0,0,12"/>


                            <!-- KOLOMNAMEN -->


                            <Grid Grid.Row="1"
                              Background="#E5E5E5"
                              Margin="0,0,0,5">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0"
                                       Text="Product"
                                       FontWeight="Bold"
                                       Foreground="Black"
                                       Margin="8"/>

                                <TextBlock Grid.Column="1"
                                       Text="Prijs/dag"
                                       FontWeight="Bold"
                                       Foreground="Black"
                                       Margin="8"/>

                                <TextBlock Grid.Column="2"
                                       Text="Dagen"
                                       FontWeight="Bold"
                                       Foreground="Black"
                                       Margin="8"/>

                                <TextBlock Grid.Column="3"
                                       Text="Totaal"
                                       FontWeight="Bold"
                                       Foreground="Black"
                                       Margin="8"/>

                            </Grid>

                            <!-- BESTELREGELS -->

                            <ListBox x:Name="lstBestelling"
                                 Grid.Row="2"
                                 Background="White"
                                 Foreground="Black"
                                 BorderBrush="#CCCCCC"
                                 Margin="0,0,0,10">

                            </ListBox>

                            <!-- VERWIJDER BESTELREGEL -->

                            <Button x:Name="btnVerwijderBestelregel"
                                Grid.Row="3"
                                Content="Verwijder geselecteerde regel"
                                Style="{StaticResource DeleteButton}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10"/>



                            <!-- TOTAALBEDRAG -->


                            <Border Grid.Row="4"
                                Background="#EEEEEE"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>


                                    <TextBlock Text="Te betalen:"
                                           Foreground="Black"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>


                                    <TextBlock x:Name="txtTotaalBedrag"
                                           Grid.Column="1"
                                           Text="€ 0,00"
                                           Foreground="Black"
                                           FontSize="27"
                                           FontWeight="Bold"/>

                                </Grid>

                            </Border>

                        </Grid>

                    </Border>



                    <!-- APART BETAALSCHERM -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#CCCCCC"
                        BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Betaal de huidige bestelling in een apart venster"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button x:Name="btnBetalingAfronden" Content="Naar betalen"
                                Style="{StaticResource DarkButton}" Width="180"/>
                        </StackPanel>
                    </Border>

                </Grid>

            </Grid>

        </ScrollViewer>

        <!-- AVG PROGRESSBAR -->


        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- AVG TEKST -->

                <StackPanel Margin="0,0,20,0">

                    <TextBlock Text="AVG"
                               Foreground="Black"
                               FontWeight="Bold"
                               FontSize="14"/>

                    <TextBlock Text="Automatisch afsluiten"
                               Foreground="#666666"
                               FontSize="11"/>

                </StackPanel>


                <!-- PROGRESSBAR -->

                <ProgressBar x:Name="prgAVG"
                             Grid.Column="1"
                             Minimum="0"
                             Maximum="60"
                             Value="60"
                             Height="20"
                             Foreground="#333333"
                             Background="#DDDDDD"
                             VerticalAlignment="Center"/>


                <!-- RESTERENDE TIJD -->

                <TextBlock x:Name="txtAVGTimer"
                           Grid.Column="2"
                           Text="60 seconden"
                           Foreground="Black"
                           FontWeight="Bold"
                           Margin="15,0,0,0"
                           VerticalAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>