 <Window x:Class="FluitendeFietser.RekenmachineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="De Fluitende Fietser - Rekenmachine"
        Width="390" Height="540"
        MinWidth="330" MinHeight="470"
        WindowStartupLocation="CenterOwner"
        Background="#F2F2F2">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="OperatorButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E1E1E1"/>
        </Style>

        <Style x:Key="EqualsButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Scherm -->
        <Border Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,12">

            <StackPanel>
                <TextBlock Text="Rekenmachine"
                           FontSize="16"
                           Foreground="#666666"/>

                <TextBlock x:Name="txtBerekening"
                           Text=""
                           FontSize="18"
                           Foreground="#666666"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           Margin="0,12,0,5"/>

                <TextBlock x:Name="txtScherm"
                           Text="0"
                           FontSize="35"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Knoppen -->
        <UniformGrid Grid.Row="1"
                     Rows="5"
                     Columns="4">

            <Button Content="C" Click="Wissen_Click"
                    Style="{StaticResource OperatorButton}"/>
            <Button Content="⌫" Click="Backspace_Click"
                    Style="{StaticResource OperatorButton}"/>
            <Button Content="±" Click="Negatief_Click"
                    Style="{StaticResource OperatorButton}"/>
            <Button Content="÷" Click="Operator_Click"
                    Style="{StaticResource OperatorButton}"/>

            <Button Content="7" Click="Cijfer_Click"/>
            <Button Content="8" Click="Cijfer_Click"/>
            <Button Content="9" Click="Cijfer_Click"/>
            <Button Content="×" Click="Operator_Click"
                    Style="{StaticResource OperatorButton}"/>

            <Button Content="4" Click="Cijfer_Click"/>
            <Button Content="5" Click="Cijfer_Click"/>
            <Button Content="6" Click="Cijfer_Click"/>
            <Button Content="−" Click="Operator_Click"
                    Style="{StaticResource OperatorButton}"/>

            <Button Content="1" Click="Cijfer_Click"/>
            <Button Content="2" Click="Cijfer_Click"/>
            <Button Content="3" Click="Cijfer_Click"/>
            <Button Content="+" Click="Operator_Click"
                    Style="{StaticResource OperatorButton}"/>

            <Button Content="0" Click="Cijfer_Click"/>
            <Button Content="," Click="Komma_Click"/>
            <Button Content="=" Click="IsGelijk_Click"
                    Style="{StaticResource EqualsButton}"/>
            <Button Content="Sluiten" Click="Sluiten_Click"
                    FontSize="14"
                    Style="{StaticResource OperatorButton}"/>

        </UniformGrid>
    </Grid>
</Window>
